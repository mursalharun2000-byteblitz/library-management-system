{
  "info": {
    "name": "Library Management System - Week 2 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"librarian@library.com\",\n  \"password\": \"password123\",\n  \"role\": \"LIBRARIAN\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"librarian@library.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Users - Get Profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/users/profile",
          "host": ["{{baseUrl}}"],
          "path": ["users", "profile"]
        }
      }
    },
    {
      "name": "Genres - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"History\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/genres",
          "host": ["{{baseUrl}}"],
          "path": ["genres"]
        }
      }
    },
    {
      "name": "Genres - Find All",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/genres",
          "host": ["{{baseUrl}}"],
          "path": ["genres"]
        }
      }
    },
    {
      "name": "Genres - Find One",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/genres/1",
          "host": ["{{baseUrl}}"],
          "path": ["genres", "1"]
        }
      }
    },
    {
      "name": "Genres - Update",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"World History\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/genres/1",
          "host": ["{{baseUrl}}"],
          "path": ["genres", "1"]
        }
      }
    },
    {
      "name": "Genres - Remove",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/genres/1",
          "host": ["{{baseUrl}}"],
          "path": ["genres", "1"]
        }
      }
    },
    {
      "name": "Books - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Architecture\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"9780134494166\",\n  \"totalCopies\": 4,\n  \"genreId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "Books - Find All (Filter, Search, Pagination)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/books?genreId=1&search=Clean&page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            { "key": "genreId", "value": "1" },
            { "key": "search", "value": "Clean" },
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "Books - Find One",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": ["{{baseUrl}}"],
          "path": ["books", "1"]
        }
      }
    },
    {
      "name": "Books - Update",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"totalCopies\": 6\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": ["{{baseUrl}}"],
          "path": ["books", "1"]
        }
      }
    },
    {
      "name": "Books - Remove",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/1",
          "host": ["{{baseUrl}}"],
          "path": ["books", "1"]
        }
      }
    }
  ]
}